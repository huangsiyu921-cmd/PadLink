<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PadLink.Gui</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationIcon>padlink.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 窗体和托盘从嵌入资源读图标，不怕文件被挪走或删掉。 -->
    <EmbeddedResource Include="padlink.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PadLink.Core\PadLink.Core.csproj" />
    <ProjectReference Include="..\PadLink.Backends.ViGEm\PadLink.Backends.ViGEm.csproj" />
    <ProjectReference Include="..\PadLink.Server\PadLink.Server.csproj" />
  </ItemGroup>

</Project>
